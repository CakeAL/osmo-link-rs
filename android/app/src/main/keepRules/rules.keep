# btleplug's Android backend reaches these classes only through JNI, so R8
# would otherwise strip them. Keep the whole packages.
-keep class com.nonpolynomial.** { *; }
-keep class io.github.gedgygedgy.** { *; }

# JNI entry points and the callback interface implemented in Kotlin.
-keep class com.cakeal.osmolink.bridge.OsmoNative { *; }
-keep interface com.cakeal.osmolink.bridge.BridgeListener { *; }
-keepclasseswithmembers class * implements com.cakeal.osmolink.bridge.BridgeListener {
    public void onEvent(java.lang.String, java.lang.String);
}
